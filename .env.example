AGAVE_VERSION=v4.3.0
# Localhost is suitable for applications running on the same server.
# For trusted LAN/VPN access, set this to the server's private interface IP.
RPC_BIND_ADDRESS=127.0.0.1
RPC_PORT=8899
WS_PORT=8900
RUST_LOG=warn
